{
  "name": "parsec-ts",
  "version": "0.1.0",
  "description": "A tiny, purely functional parser combinator library for TypeScript",
  "keywords": [
    "parser",
    "combinator",
    "parsec",
    "functional",
    "typescript"
  ],
  "license": "MIT",
  "author": "Nana Adjei Manu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naamanu/parsec-ts.git"
  },
  "homepage": "https://github.com/naamanu/parsec-ts#readme",
  "bugs": {
    "url": "https://github.com/naamanu/parsec-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fp": {
      "types": "./dist/fp.d.ts",
      "default": "./dist/fp.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "check:pack": "npm run build && node scripts/check-pack.ts",
    "docs": "typedoc",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:pack",
    "bench": "node bench/run.ts",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/*.test.ts\"",
    "version": "node scripts/sync-jsr-version.ts && git add jsr.json",
    "check:jsr": "jsr publish --dry-run --allow-dirty"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/parsimmon": "^1.10.9",
    "arcsecond": "^5.0.0",
    "fast-check": "^4.10.2",
    "jsr": "^0.14.3",
    "parsimmon": "^1.18.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0"
  }
}
