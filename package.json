{
  "name": "parsec-ts",
  "version": "0.1.0",
  "description": "A tiny, purely functional parser combinator library for TypeScript",
  "keywords": [
    "parser",
    "combinator",
    "parsec",
    "functional",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.0"
  }
}
